{
  "name": "basic-korean-web",
  "version": "1.0.0",
  "description": "韩语最小可行学习系统 - 7大骨架规则 + 断句训练 + AI智能拆句 + Edge TTS语音",
  "scripts": {
    "start": "bash start.sh",
    "web": "node web_server.js",
    "tts": "node tts_server.js",
    "dev": "node web_server.js & node tts_server.js",
    "audit": "node scripts/audit-vue-conflicts.js",
    "audit:strict": "node scripts/audit-vue-conflicts.js --fail-on-warning",
    "audit:selftest": "node scripts/audit-vue-conflicts.js --selftest",
    "audit:assets": "node scripts/asset-integrity.js",
    "audit:assets:strict": "node scripts/asset-integrity.js --strict",
    "audit:contrast": "node scripts/contrast-audit.js",
    "test:e2e:ci": "node tests/e2e/ci-run.js",
    "test:viewport": "node tests/e2e/viewport-480.js",
    "test:selfcheck": "node tests/e2e/self-check.js",
    "test:selfcheck:prod": "E2E_BASE=https://basic-korean.pages.dev node tests/e2e/self-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "wrangler": "^4.114.0"
  }
}
